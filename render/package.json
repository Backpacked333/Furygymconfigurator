{
  "name": "fury-still-renderer",
  "private": true,
  "type": "module",
  "description": "Offline batch renderer for the configurator's pre-rendered still layers.",
  "scripts": {
    "batch": "tsx src/batch.ts",
    "verify": "tsx src/verify.ts",
    "audit:seams": "tsx src/audit-seams.ts",
    "audit:relevance": "tsx src/audit-relevance.ts",
    "count": "tsx src/batch.ts --count",
    "typecheck": "../node_modules/.bin/tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "playwright": "1.56.1",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  }
}
